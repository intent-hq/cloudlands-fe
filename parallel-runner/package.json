{
  "name": "parallel-agent-runner",
  "version": "1.0.0",
  "description": "Production-ready system for running parallel agent workflows",
  "main": "lib/core/runner.js",
  "bin": {
    "parallel-runner": "./run",
    "parallel-monitor": "./monitor",
    "parallel-report": "./report"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check": "echo 'TypeScript check would run here'",
    "lint": "eslint lib/**/*.js",
    "format": "prettier --write '**/*.{js,json,md,yaml}'",
    "example:simple": "./run examples/simple-wave.yaml",
    "example:typescript": "./run examples/typescript-fixes.yaml --dry-run",
    "example:test": "TEST_MODE=true ./run examples/test-echo.yaml"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "agent",
    "parallel",
    "orchestration",
    "automation",
    "workflow"
  ],
  "author": "",
  "license": "MIT"
}
