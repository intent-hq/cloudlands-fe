    "dev:electron": "node scripts/dev-electron.js",
    "dev:electron:cdp": "node scripts/dev-electron.js --cdp",
    "kill:electron": "node scripts/kill-electron.js",
    "build": "cross-env GIT_TERMINAL_PROMPT=0 NODE_ENV=production pnpm run generate:build-config && pnpm run generate:ipc-channels && pnpm run generate:i18n && pnpm run build:renderer && concurrently \"pnpm run build:main\" \"pnpm run build:preload\"",
    "build:renderer": "pnpm run build:i18n-bundle && cross-env GIT_TERMINAL_PROMPT=0 NODE_ENV=production INTENT_DISABLE_SOURCEMAPS=1 node scripts/vite-build.mjs && node scripts/fix-renderer-paths.js && node scripts/fix-production-html.js && node scripts/copy-resources.js",
    "build:web": "pnpm run generate:i18n && pnpm run build:i18n-bundle && cross-env GIT_TERMINAL_PROMPT=0 NODE_ENV=production INTENT_DISABLE_SOURCEMAPS=1 INTENT_BUILD_TARGET=web node scripts/vite-build.mjs && node scripts/inject-production-i18n.mjs dist/web",
    "build:main": "cross-env NODE_ENV=production pnpm exec tsc -p tsconfig.main.json && pnpm exec tsx scripts/fix-esm-imports.ts",
    "build:main:dev": "pnpm run build:main && node scripts/dev-ready.js main",
    "build:cdp-mcp": "node scripts/build-cdp-mcp.js",
    "build:preload": "cross-env NODE_ENV=production pnpm run generate:ipc-channels && pnpm exec tsc -p tsconfig.preload.json && pnpm exec tsc-alias -p tsconfig.preload.json && pnpm exec tsx scripts/fix-esm-imports.ts",
    "build:preload:dev": "pnpm run build:preload && node scripts/dev-ready.js preload",
    "preview": "vite preview",
    "start": "electron .",
    "build:speech-helper": "node scripts/build-speech-helper.cjs",
    "build:keychain-helper": "node scripts/build-keychain-helper.cjs",
    "dist": "pnpm run build && node scripts/ensure-native-deps.cjs && node scripts/copy-sidecar.cjs && node scripts/fetch-tailcat.cjs && node scripts/build-speech-helper.cjs && node scripts/build-keychain-helper.cjs && electron-builder",
    "dist:mac": "pnpm run build && node scripts/ensure-native-deps.cjs && node scripts/copy-sidecar.cjs && node scripts/fetch-tailcat.cjs --targets=darwin-arm64 && node scripts/build-speech-helper.cjs && node scripts/build-keychain-helper.cjs && electron-builder --mac",
    "dist:win": "pnpm run build && node scripts/ensure-native-deps.cjs && node scripts/copy-sidecar.cjs && node scripts/fetch-tailcat.cjs --targets=win32-x64 && electron-builder --win",
    "dist:linux": "pnpm run build && node scripts/ensure-native-deps.cjs && node scripts/copy-sidecar.cjs && node scripts/fetch-tailcat.cjs --targets=linux-x64,linux-arm64 && electron-builder --linux",
    "dist:all": "pnpm run build && node scripts/ensure-native-deps.cjs && node scripts/copy-sidecar.cjs && node scripts/fetch-tailcat.cjs --targets=darwin-arm64,win32-x64,linux-x64,linux-arm64 && node scripts/build-speech-helper.cjs && node scripts/build-keychain-helper.cjs && electron-builder -mwl",
