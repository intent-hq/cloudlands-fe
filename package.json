    "test:integration:workspace": "vitest run --config tests/integration/vitest.integration.config.ts tests/integration/workspace-operations.test.ts",
    "test:integration:persistence": "vitest run --config tests/integration/vitest.integration.config.ts tests/integration/persistence-recovery.test.ts",
    "test:integration:error": "vitest run --config tests/integration/vitest.integration.config.ts tests/integration/error-recovery.test.ts",
    "test:integration:performance": "tsx scripts/test-streaming-performance.ts",
    "test:harness": "tsx tests/integration/test-harness-runner.ts",
    "test:harness:runner": "tsx tests/integration/test-harness-runner.ts",
    "test:harness:runner:verbose": "tsx tests/integration/test-harness-runner.ts --verbose",
    "test:e2e": "tsx e2e/run-e2e-tests.ts",
