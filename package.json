    "ipc:debug:missing": "tsx scripts/check-ipc-debug.ts missing",
    "ipc:debug:errors": "tsx scripts/check-ipc-debug.ts errors",
    "ipc:debug:clear": "tsx scripts/check-ipc-debug.ts clear",
    "ipc:debug:path": "tsx scripts/check-ipc-debug.ts path",
