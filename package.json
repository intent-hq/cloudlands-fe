    "test:accessibility-tree": "tsx test/test-accessibility-tree.ts",
    "test:api-reference": "tsx test/test-api-reference.ts",
    "agent-errors": "tsx scripts/agent-errors.ts",
    "memory-events": "tsx scripts/memory-events.ts",
    "test:error-tracking": "tsx scripts/test-error-tracking.ts",
