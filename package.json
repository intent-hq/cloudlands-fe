    "observe:memory:follow": "node scripts/observe-memory.js --follow",
    "observe:help": "node scripts/observe.js --help",
    "rebuild:electron": "node scripts/rebuild-sqlite.js electron",
    "rebuild:node": "node scripts/rebuild-sqlite.js node",
    "rebuild:native": "node scripts/rebuild-native.js",
    "rebuild:native:verbose": "node scripts/rebuild-native.js --verbose",
    "rebuild:native:force": "node scripts/rebuild-native.js --force",
    "test:service-integration": "tsx scripts/test-service-integration.ts",
    "test:launcher-integration": "tsx scripts/test-launcher-integration.ts",
    "test:bundled-rules": "tsx scripts/test-bundled-rules.ts",
    "test:bundled-rules:fallback": "tsx scripts/test-bundled-rules-fallback.ts",
    "type-check": "tsx scripts/type-check.ts",
