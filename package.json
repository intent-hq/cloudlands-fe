    "test:integration:workspace": "vitest run tests/integration/workspace-operations.test.ts",
    "test:integration:persistence": "vitest run tests/integration/persistence-recovery.test.ts",
    "test:integration:error": "vitest run tests/integration/error-handling.test.ts",
    "test:integration:performance": "vitest run tests/integration/performance.test.ts",
