    "test:migration": "vitest run src/features/notes/main/storage/__tests__/note-migration.test.ts src/shared/types/__tests__/branded-ids.migration.test.ts tests/integration/import-fixes.test.ts",
    "test:event-system": "vitest run src/features/events/__tests__/types.test.ts tests/event-integration.test.ts",
    "test:cdp-helpers": "tsx test/test-cdp-helpers.ts",
    "test:cdp-helpers:watch": "tsx --watch test/test-cdp-helpers.ts",
    "test:accessibility-tree": "tsx test/test-accessibility-tree.ts",
    "test:api-reference": "tsx test/test-api-reference.ts",
    "agent-errors": "tsx scripts/agent-errors.ts",
    "memory-events": "tsx scripts/memory-events.ts",
    "test:error-tracking": "tsx scripts/comprehensive-test.ts",
    "ipc:debug": "tsx scripts/check-ipc-debug.ts",
    "ipc:debug:summary": "tsx scripts/check-ipc-debug.ts summary",
    "ipc:debug:missing": "tsx scripts/check-ipc-debug.ts missing",
    "ipc:debug:errors": "tsx scripts/check-ipc-debug.ts errors",
