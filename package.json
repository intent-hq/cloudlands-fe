    "test:mcp-stdio-proxy": "tsx scripts/test-mcp-stdio-proxy.ts",
    "test:agent-launch-mcp": "tsx scripts/test-agent-launch-mcp.ts",
    "test:migration": "tsx scripts/test-complete-migration.ts",
    "test:event-system": "tsx scripts/test-event-system.ts",
    "test:cdp-helpers": "tsx test/test-cdp-helpers.ts",
