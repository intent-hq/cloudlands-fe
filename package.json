    "test:unit:watch": "vitest",
    "test:playwright": "npx playwright test",
    "test:playwright:ui": "npx playwright test --ui",
    "test:playwright:headed": "npx playwright test --headed",
    "test:run": "npm run test:unit:run && npm run test:playwright",
    "test:ci": "npm run test:unit:run && npm run test:playwright",
    "test:kill": "bash scripts/kill-test-processes.sh",
    "test:agent-launch": "tsx scripts/test-agent-launch.ts",
