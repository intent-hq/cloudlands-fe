{
  "name": "intent",
  "version": "2.6.0",
  "description": "Intent",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "generate:ipc-channels": "tsx scripts/inline-ipc-channels.ts",
    "generate:build-config": "node scripts/generate-build-config.cjs",
    "dev": "node --max-old-space-size=4096 scripts/dev-launcher.mjs",
    "dev:cdp": "node scripts/dev-launcher.mjs --cdp",
    "dev:base": "npm run generate:build-config && npm run generate:ipc-channels && concurrently \"npm run build:main\" \"npm run build:preload\" && concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:cdp:base": "pnpm run generate:build-config && pnpm run generate:ipc-channels && concurrently \"pnpm run build:main\" \"pnpm run build:preload\" && concurrently \"pnpm run dev:renderer\" \"pnpm run dev:electron:cdp\"",
    "dev:renderer": "cross-env GIT_TERMINAL_PROMPT=0 vite dev --force --strictPort",
    "dev:web": "cross-env GIT_TERMINAL_PROMPT=0 INTENT_BUILD_TARGET=web vite dev --strictPort",
    "dev:electron": "node scripts/dev-electron.js",
    "dev:electron:cdp": "node scripts/dev-electron.js --cdp",
    "kill:electron": "node scripts/kill-electron.js",
    "build": "cross-env GIT_TERMINAL_PROMPT=0 NODE_ENV=production npm run generate:build-config && npm run generate:ipc-channels && npm run build:renderer && concurrently \"npm run build:main\" \"npm run build:preload\"",
    "build:renderer": "cross-env GIT_TERMINAL_PROMPT=0 NODE_ENV=production vite build && node scripts/fix-renderer-paths.js && node scripts/fix-production-html.js && node scripts/copy-resources.js",
    "build:web": "cross-env GIT_TERMINAL_PROMPT=0 NODE_ENV=production INTENT_BUILD_TARGET=web vite build",
    "build:main": "cross-env NODE_ENV=production npx tsc -p tsconfig.main.json && npx tsx scripts/fix-esm-imports.ts",
    "build:cdp-mcp": "node scripts/build-cdp-mcp.js",
    "build:preload": "cross-env NODE_ENV=production npm run generate:ipc-channels && tsc -p tsconfig.preload.json && tsc-alias -p tsconfig.preload.json && npx tsx scripts/fix-esm-imports.ts",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "npm run build && node scripts/ensure-native-deps.cjs && node scripts/copy-sidecar.cjs && electron-builder",
    "dist:mac": "npm run build && node scripts/ensure-native-deps.cjs && node scripts/copy-sidecar.cjs && electron-builder --mac",
    "dist:win": "npm run build && node scripts/copy-sidecar.cjs && electron-builder --win",
    "dist:linux": "npm run build && node scripts/copy-sidecar.cjs && electron-builder --linux",
    "dist:all": "npm run build && node scripts/copy-sidecar.cjs && electron-builder -mwl",
    "version:set": "node scripts/set-version.cjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release:patch": "npm run version:patch && pnpm run dist:mac",
    "release:minor": "npm run version:minor && pnpm run dist:mac",
    "release:major": "npm run version:major && pnpm run dist:mac",
    "generate:release-notes": "node scripts/generate-release-notes.mjs",
    "reset-onboarding": "bash scripts/reset-onboarding.sh",
    "reset-onboarding:restore": "bash scripts/reset-onboarding.sh restore",
    "test:diff-viewer": "tsx test/test-diff-viewer.ts",
    "test:diff-viewer:watch": "tsx watch test/test-diff-viewer.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json --output human --threshold error",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:dispatch-gate": "node scripts/check-workspace-event-dispatchers.mjs",
    "lint:selector-active-workspace": "node scripts/check-selector-active-workspace-hygiene.mjs",
    "lint:redux-collections": "node scripts/check-redux-state-collections.mjs",
    "lint:reducer-determinism": "node scripts/check-reducer-nondeterminism.mjs src/store",
    "lint:agent-architecture": "node scripts/check-workspace-event-dispatchers.mjs src/features/agent && node scripts/check-workspace-event-dispatchers.mjs src/features/mcp && node scripts/check-workspace-event-dispatchers.mjs src/store/main/slices/agent-subscriptions && pnpm run lint:reducer-determinism && pnpm run type-check:validate",
    "validate:architecture": "pnpm run lint:agent-architecture && pnpm run lint:selector-active-workspace && pnpm run lint:redux-collections",
    "test": "pnpm run test:unit && pnpm run test:playwright",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:playwright": "npx playwright test",
    "test:playwright:ui": "npx playwright test --ui",
    "test:playwright:headed": "npx playwright test --headed",
    "test:run": "pnpm run test:unit && pnpm run test:playwright",
    "test:ci": "pnpm run test:unit && pnpm run test:playwright",
    "test:agent-launch": "vitest run tests/integration/agent-creation-*.test.ts",
    "test:agent-launch:verbose": "vitest run tests/integration/agent-creation-*.test.ts --reporter=verbose",
    "test:agent-operability": "vitest run src/features/agent/__tests__/provider-registry.test.ts src/features/agent/testing/programmatic-test-agent-provider.test.ts src/features/events/main/__tests__/agent-interaction-integration.test.ts src/store/main/slices/agent-subscriptions/agent-subscriptions-selectors.test.ts src/store/main/slices/agent-subscriptions/agent-subscriptions-slice.test.ts src/features/agent/main/__tests__/agent-backend-handler-event-emissions.test.ts src/features/agent/testing/reliability-stress-runner.test.ts src/shared/utils/__tests__/message-dedup.test.ts",
    "test:agent-operability:stress": "vitest run src/features/agent/testing/reliability-stress-runner.test.ts",
    "test:agent-operability:stress:matrix": "tsx scripts/run-agent-reliability-stress-matrix.ts",
    "verify:agent-operability": "pnpm run test:agent-operability && pnpm run lint:agent-architecture && pnpm run check && pnpm tsc -p tsconfig.json --noEmit && pnpm tsc -p tsconfig.main.json --noEmit && pnpm tsc -p tsconfig.preload.json --noEmit && git diff --check",
    "observe:memory": "node scripts/observe-memory.js",
    "observe:memory:follow": "node scripts/observe-memory.js --follow",
    "rebuild:native": "node scripts/rebuild-native.js",
    "rebuild:native:verbose": "node scripts/rebuild-native.js --verbose",
    "rebuild:native:force": "node scripts/rebuild-native.js --force",
    "test:service-integration": "vitest run src/features/agent/services/__tests__/*.test.ts src/shared/services/__tests__/*.test.ts",
    "test:launcher-integration": "pnpm run test:agent-launch",
    "test:bundled-rules": "vitest run src/features/agent/services/__tests__/instruction-service.test.ts src/features/agent/services/__tests__/rules-loading-integration.test.ts src/features/rules/__tests__/end-user-rules-manager.test.ts tests/integration/agent-creation-rules.test.ts",
    "test:bundled-rules:fallback": "vitest run src/features/agent/services/__tests__/instruction-service.test.ts",
    "type-check": "tsx scripts/type-check.ts",
    "type-check:quiet": "tsx scripts/type-check.ts --quiet",
    "type-check:validate": "tsx scripts/type-check.ts validate",
    "type-check:handlers": "tsx scripts/type-check.ts handlers",
    "type-check:report": "tsx scripts/type-check.ts report",
    "generate:ipc-types": "tsx scripts/generate-ipc-types.ts",
    "prebuild": "npm run type-check:quiet && npm run generate:ipc-types",
