    "test:e2e:build": "tsx e2e/run-e2e-tests.ts --build",
    "test:e2e:workflows": "tsx e2e/run-e2e-tests.ts --suite complete-workflows",
    "test:e2e:multi-agent": "tsx e2e/run-e2e-tests.ts --suite multi-agent",
    "test:e2e:error": "tsx e2e/run-e2e-tests.ts --suite error-recovery",
    "test:e2e:performance": "tsx e2e/run-e2e-tests.ts --suite performance",
    "test:e2e:ui": "tsx e2e/run-e2e-tests.ts --suite ui-rendering",
    "test:e2e:debug": "tsx e2e/run-e2e-tests.ts --debug --headed",
    "test:e2e:ci": "npm run build && npx playwright test --config=e2e/playwright.config.e2e.ts",
    "test:e2e:install": "npx playwright install chromium",
    "test:build-smoke": "npx playwright test --config=e2e/build-smoke.config.ts",
    "test:build-smoke:providers": "npx playwright test --config=e2e/build-smoke.config.ts e2e/build-smoke-providers.e2e.ts",
    "test:remote": "REMOTE_ENV_PROFILE=${PROFILE:-standard} vitest run tests/remote-env/*.test.ts",
    "test:remote:standard": "REMOTE_ENV_PROFILE=standard vitest run tests/remote-env/*.test.ts",
    "test:remote:devpod": "REMOTE_ENV_PROFILE=devpod vitest run tests/remote-env/*.test.ts",
    "test:remote:minimal": "REMOTE_ENV_PROFILE=minimal vitest run tests/remote-env/*.test.ts",
    "test:remote:all": "npm run test:remote:standard && npm run test:remote:devpod && npm run test:remote:minimal",
    "remote-env:start": "./tests/remote-env/start-remote-env.sh",
    "remote-env:start:devpod": "./tests/remote-env/start-remote-env.sh --profile devpod",
    "remote-env:start:all": "./tests/remote-env/start-remote-env.sh --all",
    "remote-env:stop": "./tests/remote-env/stop-remote-env.sh"
