    "version:patch": "pnpm version patch --no-git-tag-version",
    "version:minor": "pnpm version minor --no-git-tag-version",
    "version:major": "pnpm version major --no-git-tag-version",
    "release:patch": "pnpm run version:patch && pnpm run dist:mac",
    "release:minor": "pnpm run version:minor && pnpm run dist:mac",
    "release:major": "pnpm run version:major && pnpm run dist:mac",
