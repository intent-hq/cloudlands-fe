#!/bin/bash
# intent - Open a directory as an Intent workspace on this machine
#
# Usage:
#   intent [directory]
#   intent              # uses current directory
#   intent /path/to/dir # uses specified directory
#   intent .            # uses current directory (explicit)

set -e

# Resolve the directory path
DIR="${1:-.}"

# Resolve the folder twice: the physical path (symlinks resolved; the folder a
# new workspace is created on) and the logical path as the user reached it.
# The app matches an existing workspace against either, so a workspace created
# through a symlinked path (e.g. macOS /tmp -> /private/tmp) is still found.
if [ ! -d "$DIR" ]; then
  echo "Error: '$DIR' is not a directory" >&2
  exit 1
fi
LOGICAL_DIR="$(cd "$DIR" 2>/dev/null && pwd -L)" || {
  echo "Error: Directory '$1' does not exist" >&2
  exit 1
}
DIR="$(cd "$DIR" 2>/dev/null && pwd -P)"

# Git Bash / MSYS / Cygwin report /c/Users/...; the daemon stores C:/Users/...
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    if command -v cygpath >/dev/null 2>&1; then
      DIR="$(cygpath -m "$DIR")"
      LOGICAL_DIR="$(cygpath -m "$LOGICAL_DIR")"
    fi
    ;;
esac

# URL-encode a path (passed as an argument, never spliced into the Python
# source, so quotes and other special characters are safe)
url_encode() {
  python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe="/"))' "$1"
}

# Open the deep link: the app opens the workspace for this folder on the local
# daemon, or creates one on the folder (no worktree) when none exists.
DEEP_LINK="intent://open?path=$(url_encode "$DIR")"
if [ "$LOGICAL_DIR" != "$DIR" ]; then
  DEEP_LINK="${DEEP_LINK}&alias=$(url_encode "$LOGICAL_DIR")"
fi

# Detect dev mode by checking if electron binary exists relative to this script
# Resolve the real path of this script (following symlinks)
REAL_SCRIPT="$(readlink -f "$0" 2>/dev/null || readlink "$0" 2>/dev/null || echo "$0")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
# resources/bin/ → project root is 2 levels up
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
ELECTRON="$PROJECT_ROOT/node_modules/.bin/electron"
MAIN_ENTRY="$PROJECT_ROOT/dist/main"

if [ -x "$ELECTRON" ] && [ -d "$MAIN_ENTRY" ]; then
  # Dev mode: launch Electron.app directly via macOS open command
  # This fully detaches from terminal (no TTY takeover)
  ELECTRON_APP="$PROJECT_ROOT/node_modules/electron/dist/Electron.app"
  if [ "$(uname -s)" = "Darwin" ] && [ -d "$ELECTRON_APP" ]; then
    open -n "$ELECTRON_APP" --args "$MAIN_ENTRY" "$DEEP_LINK"
  else
    # Non-macOS fallback
    "$ELECTRON" "$MAIN_ENTRY" "$DEEP_LINK" </dev/null &>/dev/null &
    disown 2>/dev/null || true
  fi
  echo "Opening Intent (dev mode) with directory: $DIR"
else
  # Production: use OS URL scheme handler
  case "$(uname -s)" in
    Darwin)
      open "$DEEP_LINK"
      ;;
    Linux)
      xdg-open "$DEEP_LINK"
      ;;
    MINGW*|MSYS*|CYGWIN*)
      start "$DEEP_LINK"
      ;;
    *)
      echo "Error: Unsupported platform" >&2
      exit 1
      ;;
  esac
  echo "Opening Intent with directory: $DIR"
fi


