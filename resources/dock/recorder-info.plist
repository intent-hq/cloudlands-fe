<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Embedded into intent-dock-recorder via -sectcreate __TEXT __info_plist
     (build-dock-recorder.cjs). Declares why the dock clip recorder may use the
     microphone; the recorder only opens it while dictation is live during a clip
     and never requests access itself. -->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>app.cloudlands.intent.dock-recorder</string>
  <key>CFBundleName</key>
  <string>intent-dock-recorder</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Intent records your voice into a screen clip only while you are dictating.</string>
</dict>
</plist>
