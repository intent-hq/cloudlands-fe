# Isolate this project from parent workspace
shared-workspace-lockfile=false
link-workspace-packages=false

# Note: node-linker=hoisted was removed because with 1300+ packages on a deep
# path, pnpm's PATH env var exceeded Linux's 128KB MAX_ARG_STRLEN limit during
# postinstall scripts, causing E2BIG errors. The default isolated linker works
# fine with modern Electron. (pnpm#6106)
