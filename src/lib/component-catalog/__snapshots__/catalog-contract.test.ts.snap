exports[`catalog DOM, token, and accessibility contracts > 'pattern:action-menu:action-menu-states' 1`] = `
{
  "declaredStates": [
    "default",
    "disabled",
    "nested",
    "context-menu",
    "action-bar",
    "overflow",
  ],
  "dom": "<body>
  <div>
    <div data-catalog-renderer-fixture="action-menu-states" data-pattern-contract="action-menu">
      <section data-catalog-rendered-state="default">
        <div>
          <button aria-expanded="false" aria-haspopup="menu" data-dropdown-menu-trigger="" data-slot="menu-trigger" data-state="closed" id="bits-<id>" type="button">
            <span aria-hidden="true" data-slot="button-surface">
            <span data-slot="button-content">
              <span data-slot="button-label">
                "Actions"
        <output data-testid="selected">
          "none"
      <section data-catalog-rendered-state="disabled">
        <div>
          <button aria-expanded="false" aria-haspopup="menu" data-dropdown-menu-trigger="" data-slot="menu-trigger" data-state="closed" id="bits-<id>" type="button">
            <span aria-hidden="true" data-slot="button-surface">
            <span data-slot="button-content">
              <span data-slot="button-label">
                "Actions"
        <output data-testid="selected">
          "none"
      <section data-catalog-rendered-state="nested">
        <div>
          <button aria-expanded="false" aria-haspopup="menu" data-dropdown-menu-trigger="" data-slot="menu-trigger" data-state="closed" id="bits-<id>" type="button">
            <span aria-hidden="true" data-slot="button-surface">
            <span data-slot="button-content">
              <span data-slot="button-label">
                "Actions"
        <output data-testid="selected">
          "none"
      <section data-catalog-rendered-state="context-menu">
        <div>
          <button aria-controls="c<id>-content" aria-expanded="true" aria-haspopup="menu" aria-hidden="true" aria-label="Document actions" data-dropdown-menu-trigger="" data-slot="menu-trigger" data-state="open" id="bits-<id>" tabindex="-1" type="button">
            <span aria-hidden="true" data-slot="button-surface">
            <span data-slot="button-content">
              <span data-slot="button-label">
        <output data-testid="selected">
          "none"
      <section data-catalog-rendered-state="action-bar">
        <div data-slot="action-bar">
          <span id="bits-<id>" tabindex="-1">
            <div>
              <button aria-label="Edit" data-action-id="edit" data-delay-duration="200" data-slot="button" data-state="closed" data-tooltip-trigger="" type="button">
                <span aria-hidden="true" data-slot="button-surface">
                <span data-slot="button-content">
                  <span data-slot="button-label">
                    <svg aria-hidden="true" data-icon="pencil" data-weight="regular" role="img">
                      <rect>
                      <path>
          <div>
            <button aria-expanded="false" aria-haspopup="menu" aria-label="More actions" data-dropdown-menu-trigger="" data-slot="menu-trigger" data-state="closed" id="bits-<id>" type="button">
              <span aria-hidden="true" data-slot="button-surface">
              <span data-slot="button-content">
                <span data-slot="button-label">
                  <svg aria-hidden="true" role="img">
                    <rect>
                    <path>
        <output data-testid="selected">
          "none"
      <section data-catalog-rendered-state="overflow">
        <div data-slot="action-bar">
          <span id="bits-<id>" tabindex="-1">
            <div>
              <button aria-label="Edit" data-action-id="edit" data-delay-duration="200" data-slot="button" data-state="closed" data-tooltip-trigger="" type="button">
                <span aria-hidden="true" data-slot="button-surface">
                <span data-slot="button-content">
                  <span data-slot="button-label">
                    <svg aria-hidden="true" data-icon="pencil" data-weight="regular" role="img">
                      <rect>
                      <path>
          <div>
            <button aria-expanded="false" aria-haspopup="menu" aria-label="More actions" data-dropdown-menu-trigger="" data-slot="menu-trigger" data-state="closed" id="bits-<id>" type="button">
              <span aria-hidden="true" data-slot="button-surface">
              <span data-slot="button-content">
                <span data-slot="button-label">
                  <svg aria-hidden="true" role="img">
                    <rect>
                    <path>
        <output data-testid="selected">
          "none"
  <div data-bits-floating-content-wrapper="" id="bits-<id>">
    <div aria-label="Document actions" aria-orientation="vertical" data-action-menu-owner="c<id>" data-align="start" data-dropdown-menu-content="" data-list-overlay="" data-side="bottom" data-slot="menu-content" data-state="open" data-surface-level="3" id="c<id>-content" role="menu" tabindex="-1">
      <span aria-hidden="true" data-slot="menu-list-highlight">
        <div aria-hidden="true">
      <div aria-disabled="false" data-action-id="edit" data-dropdown-menu-item="" data-menu-item="true" data-slot="menu-item" id="bits-<id>" role="menuitem" tabindex="0">
        <span aria-hidden="true" data-slot="menu-item-leading">
          <svg aria-hidden="true" data-icon="pencil" data-weight="regular" role="img">
            <rect>
            <path>
        <span>
          <span>
            "Edit"
        <span aria-hidden="true">
          <kbd data-slot="shortcut-chip">
            "⌘E"
      <div aria-disabled="false" aria-expanded="false" aria-haspopup="menu" data-action-id="export" data-dropdown-menu-item="" data-dropdown-menu-sub-trigger="" data-menu-item="true" data-slot="menu-sub-trigger" data-state="closed" id="bits-<id>" role="menuitem" tabindex="-1">
        <span aria-hidden="true" data-slot="menu-item-leading">
        <span>
          <span>
            "Export"
        <span aria-hidden="true" data-slot="menu-sub-chevron">
          <svg aria-hidden="true" data-icon="chevron-right" data-weight="regular" role="img">
            <rect>
            <path>
      <div aria-describedby="c<id>-locked-reason" aria-disabled="true" data-action-id="locked" data-disabled="" data-dropdown-menu-item="" data-menu-item="true" data-slot="menu-item" id="bits-<id>" role="menuitem" tabindex="-1">
        <span aria-hidden="true" data-slot="menu-item-leading">
        <span>
          <span>
            "Locked"
          <span aria-hidden="true">
            "Requires access"
      <span id="c<id>-locked-reason">
        "Requires access"
      <div data-dropdown-menu-separator="" data-slot="menu-separator" id="bits-<id>" role="group">
      <div aria-disabled="false" data-action-id="delete" data-destructive="" data-dropdown-menu-item="" data-menu-item="true" data-slot="menu-item" id="bits-<id>" role="menuitem" tabindex="-1">
        <span aria-hidden="true" data-slot="menu-item-leading">
          <svg aria-hidden="true" data-icon="trash" data-weight="regular" role="img">
            <rect>
            <path>
        <span>
          <span>
            "Delete"",
}
`;

