                    <div class="duration-spring-fast ease-spring-fast flex focus-within:opacity-100 gap-1 group-focus-within/collection-row:opacity-100 group-hover/collection-row:opacity-100 has-[[aria-expanded=true]]:opacity-100 items-center motion-reduce:transition-none opacity-0 transition-opacity" data-slot="row-actions">
