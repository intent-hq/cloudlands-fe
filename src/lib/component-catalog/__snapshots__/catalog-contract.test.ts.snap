exports[`catalog DOM, token, and accessibility contracts > 'pattern:confirm:confirm-service' 1`] = `
{
  "declaredStates": [
    "confirm",
    "prompt",
    "alert",
    "queued",
    "busy",
    "reduced-motion",
  ],
  "dom": "<body>
  <div>
    <div data-catalog-renderer-fixture="confirm-service" data-pattern-contract="confirm">
      <section data-catalog-rendered-state="confirm">
        <div data-dialog-overlay="" data-slot="dialog-overlay" data-state="open" data-static-position="true" id="bits-<id>">
        <div aria-describedby="bits-<id>" aria-labelledby="bits-<id>" aria-modal="true" data-dialog-content="" data-overlay-surface="true" data-size="default" data-slot="dialog-content" data-state="open" data-static-position="true" data-surface-level="3" id="bits-<id>" role="dialog" tabindex="-1">
          <form data-slot="form">
            <fieldset>
              <div>
                <div data-slot="dialog-header">
                  <div aria-level="2" data-dialog-title="" data-slot="dialog-title" data-state="open" id="bits-<id>" role="heading">
                    "Confirm service"
                  <div data-dialog-description="" data-slot="dialog-description" data-state="open" id="bits-<id>">
                    "Review and confirm this catalog action."
                <div data-slot="dialog-footer">
                  <div data-size="default" data-slot="form-actions">
                    <div data-slot="form-actions-destructive">
                    <div data-slot="form-actions-end">
                      <div>
                        <button data-slot="button" type="button">
                          <span aria-hidden="true" data-slot="button-surface">
                          <span data-slot="button-content">
                            <span data-slot="button-label">
                              "Cancel"
                      <div>
                        <button data-slot="button" type="submit">
                          <span aria-hidden="true" data-slot="button-surface">
                          <span data-slot="button-content">
                            <span data-slot="button-label">
                              "Confirm"
          <div>
            <button aria-label="Close dialog" data-dialog-close="" data-slot="button" data-state="open" id="bits-<id>" tabindex="0" type="button">
              <span aria-hidden="true" data-slot="button-surface">
              <span data-slot="button-content">
                <span data-slot="button-label">
                  <svg aria-hidden="true">
                    <path>
      <section data-catalog-rendered-state="prompt">
        <div data-dialog-overlay="" data-slot="dialog-overlay" data-state="open" data-static-position="true" id="bits-<id>">
        <div aria-describedby="bits-<id>" aria-labelledby="bits-<id>" aria-modal="true" data-dialog-content="" data-overlay-surface="true" data-size="default" data-slot="dialog-content" data-state="open" data-static-position="true" data-surface-level="3" id="bits-<id>" role="dialog" tabindex="-1">
          <form data-slot="form">
            <fieldset>
              <div>
                <div data-slot="dialog-header">
                  <div aria-level="2" data-dialog-title="" data-slot="dialog-title" data-state="open" id="bits-<id>" role="heading">
                    "Confirm service"
                  <div data-dialog-description="" data-slot="dialog-description" data-state="open" id="bits-<id>">
