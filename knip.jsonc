{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The remaining 20 duplicate-export rows are deliberate KEEPs (triaged): both names in
  // each pair have live importers (icon compat aliases, per-channel schema aliases,
  // mock-module shape, etc.). Consolidation is a rename follow-up, not dead code.
  "rules": {
    "duplicates": "warn",
  },
  "entry": [
    // Electron main process (tsconfig.main.json; package.json "main" points at its build output)
    "src/main/index.ts",
    // Electron preload (tsconfig.preload.json). The compiled entry, src/preload/index.ts, is
    // gitignored output of `pnpm run generate:ipc-channels` (scripts/inline-ipc-channels.ts),
    // so knip skips it; the template carries the same imports and stands in as the entry.
    "src/preload/index.template.ts",
    // MCP server bundled separately by scripts/build-cdp-mcp.js
    "cdp-mcp-server/server.ts",
    // Custom ESLint rules imported from eslint.config.js
    "eslint-rules/*.js",
    // Scripts are invoked via package.json scripts, CI workflows (.github/workflows),
    // and electron-builder hooks (notarize/sign) — not via imports
    "scripts/*.{js,cjs,mjs,ts}",
    // Referenced from e2e/playwright.config.e2e.ts, which knip cannot load (see "playwright" below)
    "e2e/global-setup.ts",
    "e2e/global-teardown.ts",
    "e2e/mock-acp-agent.js",
    // $app alias stubs wired in playwright-ct.config.ts ctViteConfig (alias resolution
    // is not followed by knip); playwright/index.ts is listed under "playwright-ct" below
    "playwright/app-stubs/*.ts",
    // Loaded via <script src> in operate-patterns.visual.html (visual test harness)
    "src/lib/components/ui/card/operate-patterns.visual.ts",
    // Dynamically imported as import('$lib/dev-tools') in src/routes/(app)/+layout.svelte
    // (DEV-only); knip does not follow this aliased dynamic import inside .svelte
    "src/lib/dev-tools.ts",
    // Loaded by the import.meta.glob preview registry in preview-discovery.ts;
    // each module's default component export is part of that runtime contract.
    "src/**/*.preview.{ts,svelte}",
    // Loaded at runtime by cdp-mcp-server/server.ts via a computed path and copied
    // into dist by scripts/build-cdp-mcp.js — not imported as a module
    "cdp-mcp-server/cdp-helpers.js",
    // ESLint invokes this nested rule through designSystemRules; knip misses its callback-only helper usage.
    "eslint-rules/design-system/no-arbitrary-motion-or-color.js",
    // Public action-menu API from action-menu.meta.ts; consumers also import implementation modules directly.
    "src/lib/components/patterns/action-menu/index.ts",
    // Public collection metadata and row/action types; catalog and tests use the underlying modules.
    "src/lib/components/patterns/collection/index.ts",
    // Public confirm/prompt API and option types from confirm.meta.ts; internal consumers bypass this barrel.
    "src/lib/components/patterns/confirm/index.ts",
    // Public settings schema/types and useSettingsSearch API in settings.meta.ts and the generated cheatsheet.
    "src/lib/components/patterns/settings/index.ts",
    // Canonical ask-user-questions metadata and prop types; Gate C requires the public subpath.
    "src/lib/components/ui/ask-user-questions/index.ts",
    // Canonical badge variant recipe and prop types; Gate C requires the public subpath.
    "src/lib/components/ui/badge/index.ts",
    // Canonical button prop types, including catalog-documented ButtonSize; Gate C requires the subpath.
    "src/lib/components/ui/button/index.ts",
    // CheckboxGroupItem is a public alias recorded in checkbox-group.meta.ts, not a separate implementation.
    "src/lib/components/ui/checkbox-group/index.ts",
    // Canonical CopyInput metadata re-export; the catalog reads copy-input.meta.ts directly.
    "src/lib/components/ui/copy-input/index.ts",
    // Public grouped-combobox option types; compatibility harnesses import the underlying types directly.
    "src/lib/components/ui/grouped-combobox/index.ts",
    // Canonical InputGroup metadata re-export; the catalog reads input-group.meta.ts directly.
    "src/lib/components/ui/input-group/index.ts",
    // Canonical InputMessage metadata re-export; the catalog reads input-message.meta.ts directly.
    "src/lib/components/ui/input-message/index.ts",
    // Canonical message-composer metadata and prop types; direct metadata imports bypass the public barrel.
    "src/lib/components/ui/message-composer/index.ts",
    // Compatibility component/type API used through the legacy wrapper harness and root UI namespace.
    "src/lib/components/ui/searchable-combobox/index.ts",
    // Canonical slider prop/value types and metadata; catalog and component imports bypass this public barrel.
    "src/lib/components/ui/slider/index.ts",
    // Public proximity/merge-split helpers and option/result types; tests import implementation modules directly.
    "src/lib/interaction/index.ts",
    // Documented public motion API; transition/spring option types remain available without deep imports.
    "src/lib/motion/index.ts",
    // Compile-time type-assertion file, checked by tsc (pnpm run check), never imported
    "src/store/renderer/utils/context-saga-effects.typecheck.ts",
    "src/store/renderer/slices/agent-session/agent-session-slice.typecheck.ts",
  ],
  "ignore": [
    // Accordion namespace members are used in NavigationPrimitivesCatalogPreview.svelte markup; knip misses them.
    "src/lib/components/ui/accordion/index.ts",
    // Popover namespace members are used in PopoversCatalogPreview.svelte markup; knip misses them.
    "src/lib/components/ui/popover/index.ts",
    // Table namespace members are used in ContentFieldCatalogPreview.svelte markup; knip misses them.
    "src/lib/components/ui/table/index.ts",
    // Tabs namespace members are used in NavigationPrimitivesCatalogPreview.svelte markup; knip misses them.
    "src/lib/components/ui/tabs/index.ts",
    // Consumed via `import * as Card/Dialog/Menu/Sheet` namespace imports whose member
    // access happens in .svelte template markup — knip's svelte compiler does not track
    // that usage, so every export is falsely reported unused.
    "src/lib/components/ui/card/index.ts",
    "src/lib/components/ui/dialog/index.ts",
    "src/lib/components/ui/menu/index.ts",
    "src/lib/components/ui/sheet/index.ts",
    // Loaded via `@import './diff-shared-styles.css'` inside DiffViewer.svelte's
    // <style> block — knip does not parse CSS imports in svelte styles
    "src/features/file-tracking/components/diff/diff-shared-styles.css",
    // Discoverability API contract-required by scripts/ui-component-integration.test.ts
    // (Gate C): must exist and re-export every canonical ui subpath even without importers
    "src/lib/components/ui/index.ts",
    // Contract surface exercised via `vi.importActual` in system-ipc-routing.test.ts and
    // agent-subscription-contracts.test.ts — knip cannot trace importActual usage
    "src/lib/electron-bridge.ts",
    "src/main/browser-ipc-broadcast-adapter.ts",
  ],
  "project": [
    "src/**/*.{js,cjs,mjs,ts,svelte,css}",
    // Generated by `pnpm run generate:i18n` (gitignored paraglide output)
    "!src/shared/paraglide/**",
    "scripts/**/*.{js,cjs,mjs,ts}",
    "cdp-mcp-server/**/*.{js,ts}",
    // Checked-in build output of scripts/build-cdp-mcp.js, not source
    "!cdp-mcp-server/dist/**",
    "eslint-rules/**/*.js",
    "test/**/*.ts",
    "tests/**/*.ts",
    "e2e/**/*.{js,ts}",
    "playwright/**/*.ts",
  ],
  "vitest": {
    "config": ["vitest.config.ts", "tests/integration/vitest.integration.config.ts"],
  },
  "playwright": {
    // Loading multiple playwright configs fails with "Requiring @playwright/test second
    // time" (knip.dev/reference/known-issues), so config loading is disabled and each
    // config's testDir/testMatch is replicated as entry patterns below.
    "config": [],
    "entry": [
      "playwright.config.ts",
      "playwright-ct.config.ts",
      "e2e/playwright.config.e2e.ts",
      "e2e/build-smoke.config.ts",
      "src/lib/components/ui/card/operate-patterns.playwright.config.ts",
      // playwright.config.ts: testDir ./test, testMatch **/*.spec.ts
      "test/**/*.spec.ts",
      // playwright-ct.config.ts: testDir ./src, testMatch **/*.ct.spec.ts
      "src/**/*.ct.spec.ts",
      // operate-patterns.playwright.config.ts: testMatch operate-patterns.visual.spec.ts
      "src/**/*.visual.spec.ts",
      // e2e/playwright.config.e2e.ts + e2e/build-smoke.config.ts: testMatch **/*.e2e.ts
      "e2e/**/*.e2e.ts",
    ],
  },
  "playwright-ct": {
    // Same known issue as "playwright": knip resolves the `playwright test --config=…`
    // flags in package.json scripts and loads those @playwright/test configs first, after
    // which loading playwright-ct.config.ts fails. Config loading is disabled and the CT
    // plugin's default entries are replicated here.
    "config": [],
    "entry": ["playwright-ct.config.ts", "playwright/index.ts", "src/**/*.ct.spec.ts"],
  },
  // System/external binaries, not npm packages: pkill/iconutil (macOS), duckdb, flatpak,
  // idea (JetBrains launcher), auggie (Augment CLI, expected on dev/CI hosts), jq (the
  // notify-fixed-issues.sh test stub applies the script's --jq projection with it)
  "ignoreBinaries": ["pkill", "iconutil", "duckdb", "flatpak", "idea", "auggie", "jq"],
  "ignoreDependencies": [
    // Optional coverage provider: scripts/run-integration-coverage-if-available.ts probes it
    // with require.resolve and exits gracefully when absent — intentionally not declared
    "@vitest/coverage-v8",
    // Fonts loaded via url() in src/app.css — knip does not parse CSS
    "@fontsource-variable/source-serif-4",
    // Runtime body parsing for express; explicitly packed via electron-builder.yml files list
    "body-parser",
    // Spawned via resolveBin() in scripts/run-svelte-check.mjs (pnpm run check)
    "svelte-check",
    // Native module build toolchain (node-pty/ssh2 rebuilds); version pinned via pnpm overrides
    "node-gyp",
    // Loaded by the inlang CLI through project.inlang/settings.json "modules"
    "@inlang/plugin-message-format",
  ],
  // Vite dev-server URL specifiers (/@id/..., /src/..., /test/fixtures/...) imported inside
  // page.evaluate() in browser-based playwright specs — runtime URLs, not module specifiers
  "ignoreUnresolved": ["^/(@id|src|test)/.+"],
}
