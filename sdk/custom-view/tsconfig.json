{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "strict": true,
    "declaration": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "../../src/shared/custom-view-sdk",
    "outDir": "./dist"
  },
  "include": ["../../src/shared/custom-view-sdk/**/*.ts"],
  "exclude": ["../../src/shared/custom-view-sdk/**/*.test.ts"]
}
