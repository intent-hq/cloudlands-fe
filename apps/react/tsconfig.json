{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "$shared/*": ["../../src/shared/*"],
      "$features/auto-update/types": ["../../src/features/auto-update/types.ts"],
      "$features/workspace-sharing/types": ["../../src/features/workspace-sharing/types.ts"],
      "$features/events/types": ["../../src/features/events/types.ts"],
      "$store/renderer/slices/guest-sessions/guest-sessions-types": [
        "../../src/store/renderer/slices/guest-sessions/guest-sessions-types.ts"
      ],
      "$store/renderer/slices/presence/presence-types": [
        "../../src/store/renderer/slices/presence/presence-types.ts"
      ],
      "$store/renderer/slices/directory-picker/directory-picker-slice": [
        "../../src/store/renderer/slices/directory-picker/directory-picker-slice.ts"
      ],
      "@fortawesome/fontawesome-common-types": ["../../src/lib/icons/phosphor-icons.ts"],
      "$features/providers/host-execution-errors": [
        "../../src/features/providers/host-execution-errors.ts"
      ],
      "$features/agent/services/node-execution": [
        "../../src/features/agent/services/node-execution.ts"
      ],
      "$lib/*": ["../../src/lib/*"]
    }
  },
  "include": ["src", "vite*.config.ts", "../../src/types/electron.d.ts"]
}
