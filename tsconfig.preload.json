{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "nodenext",
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.preload.tsbuildinfo",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"],
    "paths": {
      "$lib/*": ["./src/lib/*"],
      "$store/*": ["./src/store/*"],
      "$shared/*": ["./src/shared/*"],
      "$features/*": ["./src/features/*"]
    }
  },
  "include": ["src/preload/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/preload/index.template.ts"]
}
