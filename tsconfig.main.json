{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "$lib/*": ["src/lib/*"],
      "$store/*": ["src/store/*"],
      "$shared/*": ["src/shared/*"],
      "$features/*": ["src/features/*"],
      "@augmentcode/ag-redux-toolkit/types": ["src/lib/store-shim/types"],
      "@augmentcode/ag-redux-toolkit/svelte-store": ["src/lib/store-shim/svelte-store"],
      "@augmentcode/ag-redux-toolkit/utils/store/create-action": ["src/lib/store-shim/utils/store/create-action"],
      "@augmentcode/ag-redux-toolkit/utils/store/create-reducer": ["src/lib/store-shim/utils/store/create-reducer"],
      "@augmentcode/ag-redux-toolkit/utils/store/boolean-preference": ["src/lib/store-shim/utils/store/boolean-preference"],
      "@augmentcode/ag-redux-toolkit/utils/collections/collection-utils": ["src/lib/store-shim/utils/collections/collection-utils"]
    },
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/types/**/*.d.ts",
    "src/main/**/*.ts",
    "src/store/main/**/*.ts",
    "src/store/utils/**/*.ts",
    "src/shared/**/*.ts",
    "src/features/**/*.ipc.ts",
    "src/features/*/main/**/*.service.ts",
    "src/features/ipc/**/*.ts",
    "src/features/mcp/**/*.ts",
    "src/features/observability/event-storage.ts",
    "src/features/observability/event-collector.ts",
    "src/features/line-changes/line-changes.store.ts",
    "src/features/agent/agent-context-registry.ts",
    "src/features/agent/agent-providers/**/*.ts",
    "src/features/agent/error-handler.ts",
    "src/features/acp-official/**/*.ts",
    "src/features/cortex/cortex-acp/**/*.ts",
    "!src/features/**/browser/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.ts",
    "src/main/ipc.ts",
    "src/main/services/**",
    "src/features/agent/agent.service.ts",
    "src/features/agent/services/unified-agent-creator.ts",
    "src/features/agent/services/batch-operations.service.ts",
    "src/features/agent/chat-read-service.ts",
    "src/features/agent/chat-send-service.ts",
    "src/features/agent/agent-subscription-read-service.ts",
    "src/features/settings/settings-hydration-service.ts",
    "**/*.client.ts",
    "src/features/**/*.store.svelte.ts",
    "src/features/**/browser/**",
    "src/lib/**",
    "src/store/renderer/**",
    "src/shared/ipc-mock-router.ts"
  ]
}
