# Intent by Augment - Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# AUTO-UPDATE CONFIGURATION
# =============================================================================

# Optional: Override the default CloudFront URL for auto-updates
# AUTO_UPDATE_URL=https://dmdri9nt15ow8.cloudfront.net

# =============================================================================
# APPLE NOTARIZATION (macOS only)
# Required for distributing signed macOS builds
# =============================================================================

# Your Apple ID email address
# APPLE_ID=your-apple-id@example.com

# App-specific password from https://appleid.apple.com/account/manage
# Generate one under "Security" > "App-Specific Passwords"
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Your 10-character Apple Team ID
# Find it at https://developer.apple.com/account -> Membership
# APPLE_TEAM_ID=XXXXXXXXXX

# =============================================================================
# SENTRY ERROR TRACKING (optional)
# =============================================================================

# Sentry DSN for error tracking
# Get this from your Sentry project settings
# SENTRY_DSN=https://xxxxxx@oxxxxxx.ingest.sentry.io/xxxxxx

# =============================================================================
# SEGMENT ANALYTICS (optional)
# =============================================================================

# Segment write key for analytics
# Get this from your Segment source settings: https://app.segment.com/
# SEGMENT_WRITE_KEY=xxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# DEVELOPMENT OPTIONS
# =============================================================================

# Enable verbose logging for workspace operations
# DEBUG_WORKSPACE=true

# Enable verbose change detector logging
# VERBOSE_CHANGE_DETECTOR=true

